generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stock {
  id             Int             @id @default(autoincrement())
  symbol         String          @unique @db.VarChar(50)
  name           String?         @db.VarChar(255)
  exchange       String?         @db.VarChar(20) // NSE_EQ, BSE_EQ
  instrumentKey  String?         @unique @map("instrument_key") @db.VarChar(100)
  instrumentType String?         @map("instrument_type") @db.VarChar(20) // EQ, FUT, OPT
  isin           String?         @db.VarChar(20)
  sector         String?         @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  categories     StockCategory[]

  @@index([symbol])
  @@index([instrumentKey])
  @@map("stocks")
}

model Instrument {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique @db.VarChar(50)
  tradingSymbol  String?  @map("trading_symbol") @db.VarChar(100)
  name           String?  @db.VarChar(255)
  exchange       String   @db.VarChar(20) // NSE, BSE
  segment        String?  @db.VarChar(50) // NSE_EQ, BSE_EQ
  instrumentKey  String?  @unique @map("instrument_key") @db.VarChar(100)
  instrumentType String?  @map("instrument_type") @db.VarChar(20) // EQ, FUT, OPT
  isin           String?  @db.VarChar(20)
  lotSize        Int?     @map("lot_size")
  tickSize       Decimal? @map("tick_size") @db.Decimal(10, 4)
  sector         String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([symbol])
  @@index([exchange, symbol])
  @@index([instrumentKey])
  @@map("instruments")
}

model Category {
  id                Int             @id @default(autoincrement())
  key               String          @unique @db.VarChar(100)
  name              String          @db.VarChar(255)
  description       String?         @db.Text
  livePriceEnabled  Boolean         @default(true) @map("live_price_enabled")
  createdAt         DateTime        @default(now()) @map("created_at")
  stocks            StockCategory[]
  strategies        Strategy[]
  backtests         BacktestResult[]

  @@map("categories")
}

model StockCategory {
  id         Int      @id @default(autoincrement())
  stockId    Int      @map("stock_id")
  categoryId Int      @map("category_id")
  addedDate  DateTime? @map("added_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([stockId, categoryId])
  @@index([categoryId])
  @@map("stock_categories")
}

model Strategy {
  id          Int              @id @default(autoincrement())
  categoryId  Int?             @map("category_id")
  description String?          @db.Text
  rules       Json?            // Array of rule strings
  params      Json?            // Strategy parameters
  metrics     Json?            // Performance metrics
  version     String?          @default("V1") @db.VarChar(20)
  promoted    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  backtests   BacktestResult[]

  @@map("strategies")
}

model BacktestResult {
  id           Int       @id @default(autoincrement())
  jobId        String    @unique @map("job_id") @db.VarChar(100)
  strategyId   Int?      @map("strategy_id")
  categoryId   Int?      @map("category_id")
  status       String?   @db.VarChar(20) // pending, running, completed, failed
  metrics      Json?
  trades       Json?
  equityCurve  Json?     @map("equity_curve")
  config       Json?
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  strategy     Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([jobId])
  @@map("backtest_results")
}

model OhlcvCache {
  id        Int       @id @default(autoincrement())
  symbol    String    @db.VarChar(50)
  interval  String    @db.VarChar(10) // day, 1hour, 30minute
  fromDate  DateTime  @map("from_date") @db.Date
  toDate    DateTime  @map("to_date") @db.Date
  data      Json      // Array of candles
  source    String?   @db.VarChar(20) // upstox, mock
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@unique([symbol, interval, fromDate, toDate])
  @@index([symbol, interval])
  @@map("ohlcv_cache")
}

model Trade {
  id                Int       @id @default(autoincrement())
  stockSymbol       String    @map("stock_symbol") @db.VarChar(50)
  category          String    @db.VarChar(100)
  strategyVersion   String    @default("V1") @map("strategy_version") @db.VarChar(20)
  direction         String    @db.VarChar(10) // BUY, SELL
  entryPrice        Decimal?  @map("entry_price") @db.Decimal(10, 2)
  targetPrice       Decimal   @map("target_price") @db.Decimal(10, 2)
  stopLoss          Decimal   @map("stop_loss") @db.Decimal(10, 2)
  trailingStop      Decimal   @map("trailing_stop") @db.Decimal(10, 2)
  currentTrail      Decimal?  @map("current_trail") @db.Decimal(10, 2)
  status            String    @db.VarChar(20) // WAITING, ACTIVE, TARGET_HIT, SL_HIT, SIDEWAYS, EXPIRED
  entryDate         DateTime? @map("entry_date")
  exitDate          DateTime? @map("exit_date")
  exitPrice         Decimal?  @map("exit_price") @db.Decimal(10, 2)
  pnl               Decimal?  @db.Decimal(10, 2)
  pnlPercent        Decimal?  @map("pnl_percent") @db.Decimal(10, 4)
  trackingDays      Int       @default(0) @map("tracking_days")
  maxTrackingDays   Int       @default(10) @map("max_tracking_days")
  signalData        Json?     @map("signal_data") // Technical indicators at signal time
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, category])
  @@index([stockSymbol, status])
  @@map("trades")
}

// ============================================
// AI Intelligence Layer Models
// ============================================

model Signal {
  id                   Int       @id @default(autoincrement())
  signalId             String    @unique @map("signal_id") @db.VarChar(100)
  categoryKey          String    @map("category_key") @db.VarChar(100)
  symbol               String    @db.VarChar(50)
  direction            String    @db.VarChar(10)
  
  entryPrice           Decimal   @map("entry_price") @db.Decimal(10, 2)
  entryConditions      Json      @map("entry_conditions")
  bufferMinutes        Int       @default(15) @map("buffer_minutes")
  aiConfidence         Decimal?  @map("ai_confidence") @db.Decimal(5, 2)
  aiValidation         Json?     @map("ai_validation")
  
  targetPrice          Decimal   @map("target_price") @db.Decimal(10, 2)
  stopLoss             Decimal   @map("stop_loss") @db.Decimal(10, 2)
  trailingStopPercent  Decimal   @map("trailing_stop_percent") @db.Decimal(5, 2)
  currentTrailingStop  Decimal?  @map("current_trailing_stop") @db.Decimal(10, 2)
  
  trackingDays         Int       @map("tracking_days")
  trackingStatus       String    @default("ACTIVE") @map("tracking_status") @db.VarChar(20)
  
  generatedAt          DateTime  @default(now()) @map("generated_at")
  expiresAt            DateTime? @map("expires_at")
  exitedAt             DateTime? @map("exited_at")
  
  currentPrice         Decimal?  @map("current_price") @db.Decimal(10, 2)
  exitPrice            Decimal?  @map("exit_price") @db.Decimal(10, 2)
  unrealizedPnL        Decimal?  @map("unrealized_pnl") @db.Decimal(10, 2)
  realizedPnL          Decimal?  @map("realized_pnl") @db.Decimal(10, 2)
  daysInTrade          Int       @default(0) @map("days_in_trade")
  
  strategyVersion      String    @default("v1") @map("strategy_version") @db.VarChar(20)
  failureReason        String?   @map("failure_reason") @db.Text
  marketContext        Json?     @map("market_context")
  telegramSent         Boolean   @default(false) @map("telegram_sent")
  
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  
  shadowLearnings      ShadowLearning[]
  
  @@index([categoryKey, trackingStatus])
  @@index([symbol, trackingStatus])
  @@index([trackingStatus])
  @@map("signals")
}

model ShadowLearning {
  id                   Int      @id @default(autoincrement())
  categoryKey          String   @map("category_key") @db.VarChar(100)
  signalId             String?  @map("signal_id") @db.VarChar(100)
  signal               Signal?  @relation(fields: [signalId], references: [signalId], onDelete: SetNull)
  
  failureType          String   @map("failure_type") @db.VarChar(50)
  aiAnalysis           Json     @map("ai_analysis")
  rootCause            String?  @map("root_cause") @db.Text
  suggestedImprovement Json     @map("suggested_improvement")
  
  priceHistory         Json?    @map("price_history")
  volumeProfile        Json?    @map("volume_profile")
  marketSentiment      String?  @map("market_sentiment") @db.VarChar(20)
  newsEvents           Json?    @map("news_events")
  
  appliedToShadow      Boolean  @default(false) @map("applied_to_shadow")
  confidence           Decimal? @db.Decimal(5, 2)
  
  createdAt            DateTime @default(now()) @map("created_at")
  
  @@index([categoryKey])
  @@index([failureType])
  @@map("shadow_learnings")
}

model StrategyVersion {
  id                   Int       @id @default(autoincrement())
  categoryKey          String    @map("category_key") @db.VarChar(100)
  version              String    @db.VarChar(20)
  
  description          String    @db.Text
  rules                Json
  params               Json
  
  accuracy             Decimal?  @db.Decimal(5, 2)
  totalSignals         Int       @default(0) @map("total_signals")
  successfulSignals    Int       @default(0) @map("successful_signals")
  failedSignals        Int       @default(0) @map("failed_signals")
  avgPnL               Decimal?  @map("avg_pnl") @db.Decimal(10, 2)
  maxDrawdown          Decimal?  @map("max_drawdown") @db.Decimal(10, 2)
  expectancy           Decimal?  @db.Decimal(10, 4)
  
  isActive             Boolean   @default(false) @map("is_active")
  isShadow             Boolean   @default(false) @map("is_shadow")
  promotedAt           DateTime? @map("promoted_at")
  promotedFrom         String?   @map("promoted_from") @db.VarChar(20)
  
  aiGenerated          Boolean   @default(false) @map("ai_generated")
  learningSource       Json?     @map("learning_source")
  
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  
  @@unique([categoryKey, version])
  @@index([categoryKey, isActive])
  @@map("strategy_versions")
}

model TelegramConfig {
  id                   Int      @id @default(autoincrement())
  botToken             String   @map("bot_token") @db.VarChar(500)
  chatId               String   @map("chat_id") @db.VarChar(100)
  enabled              Boolean  @default(false)
  
  notifySignals        Boolean  @default(true) @map("notify_signals")
  notifyUpdates        Boolean  @default(true) @map("notify_updates")
  notifyExits          Boolean  @default(true) @map("notify_exits")
  notifyAIInsights     Boolean  @default(true) @map("notify_ai_insights")
  
  dailyUpdateTime      String?  @map("daily_update_time") @db.VarChar(10)
  
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  
  @@map("telegram_config")
}

model MarketSentimentLog {
  id                   Int       @id @default(autoincrement())
  symbol               String    @db.VarChar(50)
  date                 DateTime  @db.Date
  
  sentiment            String    @db.VarChar(20)
  score                Decimal   @db.Decimal(5, 2)
  
  aiAnalysis           Json      @map("ai_analysis")
  keyEvents            Json?     @map("key_events")
  recommendation       String?   @db.VarChar(20)
  
  newsSources          Json?     @map("news_sources")
  socialMediaData      Json?     @map("social_media_data")
  marketIndicators     Json?     @map("market_indicators")
  
  createdAt            DateTime  @default(now()) @map("created_at")
  
  @@unique([symbol, date])
  @@index([symbol])
  @@map("market_sentiment_log")
}
