# Upstox API credentials
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/upstox/callback
# Optional: override Upstox API base (default https://api.upstox.com)
UPSTOX_API_BASE=https://api.upstox.com
# Optional: adjust OAuth scopes if Upstox changes requirements
UPSTOX_OAUTH_SCOPE=marketdata:read historical:read profile:read

# Session secret for signing cookies/JWTs
SESSION_SECRET=change_me

# Backend port
BACKEND_PORT=3001
