{
  "name": "chenna-trading-system-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
  "preview": "vite preview --port 5174",
  "backend:start": "cmd /c chenna-CTS\\backend\\backend_run.cmd",
  "test:backend": "jest --config jest.config.cjs backend/__tests__/result-contract.test.cjs",
    "perf:smoke": "node backend/strategy/perf-run-50.cjs",
  "smoke:ci": "node scripts/smoke-test-dry-run.cjs",
  "smoke:ci-backtest": "node scripts/ci-backtest-smoke.cjs",
    "smoke:http": "node scripts/smoke-http.cjs",
  "smoke:optimize": "node scripts/backend_smoke_optimize.cjs",
    "verify:replay": "node scripts/replay-verify-adapter.cjs --symbol ADANIPORTS --from 2025-10-01 --to 2025-10-30 --interval day",
    "feed:sim": "node scripts/feed-sim-start.cjs --symbols SMOKE --count 10 --intervalMs 1000",
    "feed:poll": "node scripts/feed-poll-start.cjs --symbols ADANIPORTS --intervalMs 60000",
    "docker:build-runworker": "docker build -t cts-run-worker -f backend/strategy/docker/Dockerfile .",
    "run:local": "powershell -File scripts/run-worker-local.ps1 -PayloadPath payload.json",
    "smoke:local": "powershell -File scripts/run-worker-local.ps1 -PayloadPath payload.json",
    "k8s:configmap": "powershell -File scripts/k8s-run-with-configmap.ps1 -PayloadPath payload.json",
    "k8s:secret": "powershell -File scripts/k8s-run-with-secret.ps1 -PayloadPath payload.json",
    "test:coverage": "jest --coverage --runInBand",
    "secrets:scan": "node scripts/scan-secrets.cjs",
    "paper:daily": "node scripts/paper_daily_run.cjs",
    "paper:monitor": "node scripts/monitor_paper_rollout.cjs"
  },
  "scripts-dev": {
    "test:e2e": "node frontend/e2e/run-e2e.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.13.1",
    "dotenv": "^17.2.3",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.22",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.40.0",
    "postcss": "^8.5.6",
    "puppeteer": "^23.11.1",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.2.0",
    "whatwg-fetch": "^3.6.20"
  }
}
